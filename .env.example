# OKX exchange / Onchain OS REST API credentials (HMAC triple)
# Get from: OKX account -> API management (www.okx.com) — DO NOT COMMIT REAL VALUES
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# Ops wallet PUBLIC address (0x…) — funds writer/oracle gas on X Layer (§10.4).
# Public address only; NEVER put a private key here. Read by scripts/check-wallet.ts (D0.3).
OPS_WALLET_ADDRESS=

# On-chain settlement wallet for x402 EIP-3009 signing on X Layer (chainId 196)
# Required ONLY if OKX Payment API settles self-custody (see D0.1 notes, auth model UNVERIFIED)
XLAYER_SETTLEMENT_PRIVATE_KEY=

# OKX Onchain OS x402 facilitator base URL (fill from official docs once reachable)
OKX_X402_FACILITATOR_URL=

# Reown Cloud (WalletConnect) project id for the dashboard's RainbowKit wallet modal.
# Create one at https://cloud.reown.com. PUBLIC (NEXT_PUBLIC_) — safe to ship to the browser.
# Without it, injected wallets (OKX, MetaMask) still work; only the WalletConnect QR path is disabled.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Server secret for the SIWE session cookie HMAC. REQUIRED in any deployed environment (sessions must
# survive across serverless invocations); a random per-process secret is used in dev if unset.
AUTH_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Consumer Pack (governed consumer execution — shopping, domains, travel, gifts,
# notifications). See docs/consumer-pack.md and docs/consumer-pack-runbook.md.
#
# NONE of the keys below exist in any Untch environment today. That is why every
# provider ships at maturity `sandbox` or `experimental` and why no provider can
# execute: promotion to `verified` requires a real observed settlement, which
# requires a funded treasury wallet. Filling these in is what makes execution
# possible; it is not what makes a provider verified.
# ─────────────────────────────────────────────────────────────────────────────

# --- Settlement rails (private keys — NEVER commit a real value) -------------

# Base (eip155:8453) USDC float. Pays StableDomains, StableEmail, StableMerch,
# StableTravel. This is the ONE rail this build can actually settle on.
CONSUMER_TREASURY_BASE_PRIVATE_KEY=

# Solana mainnet USDC float. Purch settles ONLY here. Setting this does NOT make
# the Solana rail executable: the x402 payload serialization could not be
# confirmed from an authoritative source, so X402SolanaExactClient.available()
# is false by design. See packages/consumer-providers/src/x402/solana-exact.ts.
CONSUMER_TREASURY_SOLANA_SECRET_KEY=

# Tempo (eip155:4217) MPP float. Parsed but not executable — the advertised
# currency identifier could not be confirmed as an ERC-20 address, so its
# decimals are unknown and a charge amount cannot be scaled correctly.
CONSUMER_TREASURY_TEMPO_PRIVATE_KEY=

# --- SIWX identity -----------------------------------------------------------
# Signs Sign-In-With-X (eip191) authentication for provider MANAGEMENT endpoints
# (StableMerch drafts, StableDomains DNS + registrant profile). It holds no funds
# and authorises no spend — keep it separate from every treasury key. Absent ⇒
# SIWX-gated endpoints return PROVIDER_UNAUTHORIZED rather than a fake success.
CONSUMER_SIWX_PRIVATE_KEY=

# --- Rail RPC endpoints ------------------------------------------------------
CONSUMER_BASE_RPC_URL=https://mainnet.base.org
CONSUMER_SOLANA_RPC_URL=
CONSUMER_TEMPO_RPC_URL=

# --- Treasury limits ---------------------------------------------------------
# Below the floor, a capability is refused rather than minted, so a single large
# purchase cannot drain a rail and strand everything queued behind it.
CONSUMER_BASE_MIN_BALANCE=5.00
CONSUMER_BASE_DAILY_LIMIT=500.00
# An account is DISABLED until an operator has funded it and set this to 1.
CONSUMER_BASE_TREASURY_ENABLED=

# --- Execution policy --------------------------------------------------------
# Hard ceiling on any single consumer execution, in the funding asset (USDT0).
CONSUMER_MAX_SINGLE_EXECUTION=50.00
CONSUMER_QUOTE_TTL_SEC=600
CONSUMER_FUNDING_TTL_SEC=1800
CONSUMER_PROVIDER_TIMEOUT_MS=2500
CONSUMER_EXECUTE_TIMEOUT_MS=20000
CONSUMER_BREAKER_THRESHOLD=5
CONSUMER_BREAKER_COOLDOWN_MS=60000

# Allow a `sandbox` provider to execute. LEAVE THIS UNSET IN PRODUCTION.
# It reaches exactly one rung of the maturity ladder — `experimental` and
# `disabled` are never executable under any configuration. Every intent executed
# under it is stamped and loudly logged, so no receipt can imply the provider was
# verified.
CONSUMER_ALLOW_SANDBOX_EXECUTION=

# --- Live provider smoke tests (opt-in, SPENDS REAL MONEY) -------------------
# Required by scripts/consumer-smoke.ts. Both must be set, and the script refuses
# to spend more than CONSUMER_SMOKE_MAX_SPEND in total.
CONSUMER_SMOKE_ENABLED=
CONSUMER_SMOKE_MAX_SPEND=1.00
