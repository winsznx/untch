# OKX exchange / Onchain OS REST API credentials (HMAC triple)
# Get from: OKX account -> API management (www.okx.com) — DO NOT COMMIT REAL VALUES
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# Ops wallet PUBLIC address (0x…) — funds writer/oracle gas on X Layer (§10.4).
# Public address only; NEVER put a private key here. Read by scripts/check-wallet.ts (D0.3).
OPS_WALLET_ADDRESS=

# On-chain settlement wallet for x402 EIP-3009 signing on X Layer (chainId 196)
# Required ONLY if OKX Payment API settles self-custody (see D0.1 notes, auth model UNVERIFIED)
XLAYER_SETTLEMENT_PRIVATE_KEY=

# OKX Onchain OS x402 facilitator base URL (fill from official docs once reachable)
OKX_X402_FACILITATOR_URL=

# Reown Cloud (WalletConnect) project id for the dashboard's RainbowKit wallet modal.
# Create one at https://cloud.reown.com. PUBLIC (NEXT_PUBLIC_) — safe to ship to the browser.
# Without it, injected wallets (OKX, MetaMask) still work; only the WalletConnect QR path is disabled.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Server secret for the SIWE session cookie HMAC. REQUIRED in any deployed environment (sessions must
# survive across serverless invocations); a random per-process secret is used in dev if unset.
AUTH_SECRET=
