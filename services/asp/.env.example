# services/asp local env — copy to services/asp/.env (gitignored). NEVER commit real values.
#
# The OKX seller API triple (OKX_API_KEY / OKX_SECRET_KEY / OKX_PASSPHRASE) is read from the
# repo-root .env by the `serve` / `pay` scripts (--env-file=../../.env). Only the vars below
# are asp-local.

# Seller receiving wallet (PUBLIC 0x address on X Layer). Where ping_untch revenue settles.
PAY_TO_ADDRESS=

# Buyer EVM private key (self-custody EIP-3009 signer). Written by `pnpm gen-buyer-wallet`.
# Burner only. The wallet must hold >= $0.01 of USDT0 on X Layer mainnet before `pnpm pay`.
BUYER_PRIVATE_KEY=

# §7.4 receipt writer (optional locally; set on the Railway seller service). When BOTH are present,
# preflight_payment enqueues a durable receipt and returns a real {receiptId, status:"QUEUED"} in
# receiptRef; when absent, receiptRef stays null. The seller never gets the writer key.
# DATABASE_URL=postgresql://...
# REDIS_URL=redis://...

# Optional overrides
# ASP_PORT=4021
# SELLER_URL=http://localhost:4021
