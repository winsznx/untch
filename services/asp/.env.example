# services/asp local env — copy to services/asp/.env (gitignored). NEVER commit real values.
#
# The OKX seller API triple (OKX_API_KEY / OKX_SECRET_KEY / OKX_PASSPHRASE) is read from the
# repo-root .env by the `serve` / `pay` scripts (--env-file=../../.env). Only the vars below
# are asp-local.

# Seller receiving wallet (PUBLIC 0x address on X Layer). Where ping_untch revenue settles.
PAY_TO_ADDRESS=

# Buyer EVM private key (self-custody EIP-3009 signer). Written by `pnpm gen-buyer-wallet`.
# Burner only. The wallet must hold >= $0.01 of USDT0 on X Layer mainnet before `pnpm pay`.
BUYER_PRIVATE_KEY=

# §7.4 receipt writer + policy store (both use the SAME Railway Postgres — no second instance).
# DATABASE_URL present ⇒ preflight/create load real stored policies AND receipts are durable.
# REDIS_URL present ⇒ preflight_payment enqueues a durable receipt (receiptRef non-null). Use the
# Postgres PUBLIC proxy URL for local runs (…proxy.rlwy.net:PORT); the seller never gets the writer key.
# DATABASE_URL=postgresql://...
# REDIS_URL=redis://...

# Policy mutation signing (create/update/pause_policy). The INTERIM demo/burner operator wallet
# 0x98F43e… — a TEMPORARY stand-in for the operator's own dashboard-connected wallet (§15), NOT a
# permanent custodial key. Unset ⇒ the mutation tools return 503; the read path still works. Testnet-
# funded OKB required to broadcast. Overridable: RPC_URL, POLICY_REGISTRY (default 0xe1d74c90…3532).
# OPERATOR_PRIVATE_KEY=0x...

# For the buyer proof scripts (preflight:proof / receipt:e2e) — bind intents to a real stored policy.
# Printed by `pnpm --filter @untch/asp policy:e2e` and recorded in the policy-store testnet receipt.
# DEMO_POLICY_ID=
# DEMO_POLICY_HASH=0x...

# Optional overrides
# ASP_PORT=4021
# SELLER_URL=http://localhost:4021
# ASP_PUBLIC_URL=https://asp.untch.xyz

# Launch Pack naming LLM (optional — hireable without; fallback is deterministic Untch-style)
# Prefer one of:
#   XAI_API_KEY=...
#   GROQ_API_KEY=...
#   OPENAI_API_KEY=... + OPENAI_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENAI_MODEL=llama-3.3-70b-versatile

# ERC-8004 Identity card (served at /agent-registration.json + /.well-known/agent-registration.json)
# After minting with scripts/register-erc8004-agent.ts, set agentId so registrations[] fills:
# ERC8004_AGENT_ID=
# ERC8004_ACTIVE=true
# ERC8004_IMAGE_URL=https://www.untch.xyz/brand/untch-icon-2048.png
# ERC8004_AGENT_URI=https://asp.untch.xyz/agent-registration.json
