{
  "name": "@untch/asp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Untch A2MCP ASP — x402 seller on X Layer via the OKX facilitator: ping_untch ($0.01 proof-of-rail), create_spend_intent (bundled canon hash), preflight_payment ($0.05, real §7.1 policy engine) + the local buyer driver.",
  "scripts": {
    "start": "tsx src/server.ts",
    "serve": "tsx --env-file=../../.env --env-file=.env src/server.ts",
    "gen-buyer-wallet": "tsx src/gen-buyer-wallet.ts",
    "pay": "tsx --env-file=../../.env --env-file=.env src/run-paid-call.ts",
    "pay:remote": "tsx --env-file=.env src/pay-remote.ts",
    "preflight:proof": "tsx --env-file=../../.env --env-file=.env src/run-preflight-proof.ts",
    "guarded:e2e": "tsx --env-file=../../.env --env-file=.env src/run-guarded-e2e-proof.ts",
    "escalation:e2e": "tsx --env-file=../../.env --env-file=.env src/run-escalation-e2e-proof.ts",
    "escalation:live": "tsx --env-file=../../.env --env-file=.env src/run-escalation-live-proof.ts",
    "escalation:proof": "tsx --env-file=../../.env --env-file=.env src/run-escalation-channel-proof.ts",
    "receipt:e2e": "tsx --env-file=../../.env --env-file=.env src/run-receipt-e2e-proof.ts",
    "verify:e2e": "tsx --env-file=../../.env --env-file=.env src/run-verify-e2e-proof.ts",
    "policy:e2e": "tsx --env-file=../../.env --env-file=.env src/run-policy-e2e-proof.ts",
    "policy:multitenant": "tsx --env-file=../../.env --env-file=.env src/run-multi-tenant-policy-proof.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@okxweb3/x402-core": "^0.1.0",
    "@okxweb3/x402-evm": "^0.2.1",
    "@okxweb3/x402-express": "^0.1.1",
    "@okxweb3/x402-fetch": "^0.1.0",
    "@untch/canon": "workspace:*",
    "@untch/escalation": "workspace:*",
    "@untch/policy-engine": "workspace:*",
    "@untch/policy-store": "workspace:*",
    "@untch/proof-engine": "workspace:*",
    "@untch/receipt-writer": "workspace:*",
    "@untch/reports": "workspace:*",
    "@untch/trust-bureau": "workspace:*",
    "@untch/x402-guard": "workspace:*",
    "express": "^4.21.2",
    "tsx": "^4.19.2",
    "viem": "^2.55.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.3"
  }
}
