{
  // The ASP Worker. Two named environments so a preview can never be mistaken for the listed
  // endpoint: different Worker names, different public base URLs, and no custom domain on preview.
  //
  // Every posture value here is the SAFE one. Arming and write ownership are deliberately absent from
  // the top level and set to "0" per environment, so a Worker deployed from this file cannot spend
  // money or claim production writes until somebody changes it on purpose.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "untch-asp-preview",
  "main": "../src/workers/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  "observability": { "enabled": true, "head_sampling_rate": 1 },

  "vars": {
    "UNTCH_ENVIRONMENT": "preview",
    "UNTCH_FINANCIAL_ARMED": "0",
    "UNTCH_PRODUCTION_WRITER_ACTIVE": "0",
    // The published payee. A public address, already committed in packages/shared/src/role-addresses.ts
    // and in every generated service schema — not a secret, and wrong here would tell a paying client
    // to send USDT0 somewhere Untch does not control.
    "PAY_TO_ADDRESS": "0xD9eD4D474B0D01031d10d637546450F39ed6a5ba"
  },

  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "14c781385e4e40759d958fed8a6852c0" }
  ],

  // The preview has its OWN queue, and that is a safety property rather than tidiness.
  //
  // A Cloudflare Queue accepts exactly one consumer, so while the preview consumed
  // `untch-approval-delivery` the production Worker could not — the deploy that first tried it failed
  // with "already has a consumer". Worse, both Workers were producing into the same queue, which meant
  // the only thing stopping a preview from draining production's approval deliveries was the writer
  // gate refusing each claim. That is a runtime check standing in for an isolation boundary.
  //
  // Separate queues make it structural: a preview deployment cannot enqueue into, or drain from, the
  // queue production uses, whatever its gates say.
  "queues": {
    "producers": [{ "binding": "APPROVAL_DELIVERY", "queue": "untch-approval-delivery-preview" }],
    "consumers": [
      {
        "queue": "untch-approval-delivery-preview",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        // Bounded retries, then the dead-letter queue. Retrying forever is how a poison message
        // occupies a queue indefinitely.
        "max_retries": 5,
        "dead_letter_queue": "untch-approval-delivery-preview-dlq"
      }
    ]
  },

  // Derived from services/asp/src/workers/jobs.ts. CI asserts these match `requiredCrons()` so the
  // config cannot drift from the code.
  "triggers": {
    "crons": ["* * * * *", "*/5 * * * *"]
  },

  "env": {
    "production": {
      "name": "untch-asp",
      "vars": {
        "UNTCH_ENVIRONMENT": "production",
        // ARMED 2026-08-07. Settlement is now genuinely gated on this: the paid path asserts
        // `settle-payment` before converting an authorization into a transfer, which it previously
        // did not. Armed because marketplace-native acceptance has to actually settle; a challenge
        // that can never be honoured is worse than no listing. Preview stays disarmed.
        "UNTCH_FINANCIAL_ARMED": "1",
        // CUTOVER 2026-08-07T03:08:20Z. Railway was frozen (deployments removed, zero row growth
        // verified over 90s) and all 74 tables proved byte-identical by row fingerprint before this
        // flipped. Preview stays "0": one writer, and it is this one.
        "UNTCH_PRODUCTION_WRITER_ACTIVE": "1",
        "ASP_PUBLIC_URL": "https://asp.untch.xyz",
        "PAY_TO_ADDRESS": "0xD9eD4D474B0D01031d10d637546450F39ed6a5ba"
      },
      "observability": { "enabled": true, "head_sampling_rate": 1 },
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "14c781385e4e40759d958fed8a6852c0" }],
      "queues": {
        "producers": [{ "binding": "APPROVAL_DELIVERY", "queue": "untch-approval-delivery" }],
        "consumers": [
          {
            "queue": "untch-approval-delivery",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "dead_letter_queue": "untch-approval-delivery-dlq"
          }
        ]
      },
      "triggers": { "crons": ["* * * * *", "*/5 * * * *"] }
    }
  }
}
