# @untch/policy-store env. Copy to .env (gitignored) for local runs. The SAME Railway Postgres the
# receipt writer uses — no second instance.

# Postgres. Read side (PolicyProvider for preflight) needs only this. Use the PUBLIC proxy URL locally
# (…proxy.rlwy.net:PORT), the internal railway.internal host only from inside Railway.
DATABASE_URL=

# The operator wallet that SIGNS registerPolicy/updatePolicy/pausePolicy (write side only). In this
# interim build this is the demo/burner wallet 0x98F43e… — a TEMPORARY stand-in for the operator's
# own dashboard-connected wallet (§15), NEVER a permanent custodial key. Testnet-funded OKB required.
OPERATOR_PRIVATE_KEY=

# X Layer testnet RPC + the deployed PolicyRegistry (§10.1). Defaults shown (post-lint-fix redeploy).
RPC_URL=https://testrpc.xlayer.tech
POLICY_REGISTRY=0xe1d74c90801db0fa806c72eb818b7671b8233532
