# @untch/receipt-writer — worker env. Copy to .env (gitignored) for local runs.
# The SELLER only needs DATABASE_URL + REDIS_URL (it enqueues; it never signs or touches the chain).
# The WORKER needs all of these.

# Postgres (Railway managed). Durable source of truth for receipts + ledger.
DATABASE_URL=

# Redis (Railway managed). BullMQ batching signal transport (not authoritative state).
REDIS_URL=

# The authorized writer signing key — WORKER ONLY. Generated by scripts/gen-writer-wallet.ts,
# authorized on-chain by scripts/provision-receipt-writer.ts. NEVER put this on the seller.
WRITER_PRIVATE_KEY=

# X Layer testnet RPC + the deployed UntchReceipts (§10.3). Defaults shown.
RPC_URL=https://testrpc.xlayer.tech
RECEIPTS_CONTRACT=0x0c64997277b7d94d2999dea22a123cac56334863

# §7.4 batching + anchoring tuning (defaults shown).
BATCH_MAX_SIZE=25
BATCH_MAX_WAIT_MS=10000
RETRY_MAX=5
RETRY_BACKOFF_BASE_MS=500
CONFIRM_DEPTH=3
RECONCILE_INTERVAL_MS=5000
