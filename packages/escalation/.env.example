# @untch/escalation env. Copy to .env (gitignored) for local runs. Uses the SAME shared Railway
# Postgres + Redis the receipt writer and policy store use — no new database, no second Redis.

# Postgres (source of truth for escalation state). Use the PUBLIC proxy URL locally
# (…proxy.rlwy.net:PORT); the internal railway.internal host only resolves inside Railway.
DATABASE_URL=

# Redis (BullMQ timeout jobs — the SAME instance the receipt writer already provisions).
REDIS_URL=

# §7.2 timeouts. defaultTimeoutMin applies when a policy omits escalationTimeoutMin; maxTimeoutMin is a
# hard clamp so a pathological policy value can't keep an approval code answerable forever.
ESCALATION_DEFAULT_TIMEOUT_MIN=30
ESCALATION_MAX_TIMEOUT_MIN=1440

# ── Telegram channel (the ONE real channel; D0.7) ────────────────────────────────────────────────
# Bot token from @BotFather. TELEGRAM_CHAT_ID is the INTERIM handle binding (see README →
# "Handle-binding interim"): the single operator chat bound to the one demo operator this build uses.
# TEMPORARY — replaced by a real dashboard-driven onboarding/binding flow (§15).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Overridable Bot API base (mock server in tests). Defaults to https://api.telegram.org.
TELEGRAM_API_BASE=

# ── Discord channel (a second real channel; gateway/WebSocket) ────────────────────────────────────
# Bot token from the Discord Developer Portal. DISCORD_USER_ID is the INTERIM handle binding: the demo
# operator's Discord user id (same person as TELEGRAM_CHAT_ID, another surface). The gateway needs the
# MESSAGE CONTENT privileged intent enabled in the portal for the "APPROVE <code>" DM text baseline;
# button taps work without it. Configure to register Discord; omit to leave it unwired (honest).
DISCORD_BOT_TOKEN=
DISCORD_USER_ID=
# Overridable REST base + gateway URL (mock server/gateway in tests).
DISCORD_API_BASE=
DISCORD_GATEWAY_URL=

# ── Slack channel (a third real channel; Socket Mode/WebSocket) ───────────────────────────────────
# SLACK_BOT_TOKEN (xoxb-) sends the DM; SLACK_APP_TOKEN (xapp-, Socket Mode connections:write) opens the
# socket; SLACK_USER_ID is the INTERIM handle binding (the demo operator's Slack user id, same person).
# Socket Mode needs no public endpoint. Configure to register Slack; omit to leave it unwired.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_USER_ID=
# Overridable Web API base (mock server in tests). Defaults to https://slack.com/api.
SLACK_API_BASE=
