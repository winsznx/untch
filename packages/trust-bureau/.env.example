# @untch/trust-bureau — §12 Bureau env. Copy to .env (gitignored) for local runs.
# The SELLER reads/writes score_snapshots + reads receipts/escalations — it needs DATABASE_URL (and, for
# the wallet feature, an X Layer RPC), but NEVER the writer key.
# The ANCHOR job / prove-score-anchor additionally needs the WRITER key to submit anchorScore.

# Shared Railway Postgres (same instance as receipt-writer/policy-store/escalation). No new instance.
DATABASE_URL=

# X Layer MAINNET RPC for wallet_operational_profile of payout addresses (read-only, no key).
# Defaults to the chain's public RPC if unset.
XLAYER_RPC_URL=

# ── ANCHOR job only ──────────────────────────────────────────────────────────
# The authorized UntchReceipts writer key (same key the receipt writer uses). WORKER/anchor job ONLY.
WRITER_PRIVATE_KEY=

# UntchReceipts anchor target (§10.3) + testnet RPC. Defaults shown.
RPC_URL=https://testrpc.xlayer.tech
RECEIPTS_CONTRACT=0x0c64997277b7d94d2999dea22a123cac56334863
