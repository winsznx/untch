{
  "name": "untch",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.4"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check-wallet": "tsx scripts/check-wallet.ts",
    "gen:fixtures": "tsx packages/canon/scripts/gen-fixture-hashes.ts",
    "test:canon": "node --import tsx --test packages/canon/test/*.test.ts",
    "test:policy": "node --import tsx --test packages/policy-engine/test/*.test.ts",
    "test:proof": "node --import tsx --test packages/proof-engine/test/*.test.ts",
    "test:asp": "node --import tsx --test services/asp/test/*.test.ts",
    "test:receipt-writer": "node --import tsx --test packages/receipt-writer/test/*.test.ts",
    "test:escalation": "node --import tsx --test packages/escalation/test/*.test.ts",
    "test:web": "node --import tsx --test apps/web/test/*.test.ts",
    "prove:policy-ui": "tsx scripts/prove-policy-onchain.ts",
    "test:trust-bureau": "node --import tsx --test packages/trust-bureau/test/*.test.ts",
    "gen:writer-wallet": "tsx scripts/gen-writer-wallet.ts",
    "provision:writer": "tsx scripts/provision-receipt-writer.ts",
    "prove:network-switch": "tsx scripts/prove-network-switch.ts",
    "soak:decisions": "tsx scripts/soak-decisions.ts",
    "soak:onchain": "bash scripts/soak/run-onchain.sh",
    "soak:prepare-public": "tsx scripts/soak/prepare-public-bundle.ts && tsx scripts/soak/render-runbook.ts",
    "test:key-rotations": "tsx scripts/soak/test-key-rotations.ts",
    "verify:role-separation": "tsx scripts/soak/verify-role-separation.ts",
    "verify:deployment-roles": "tsx scripts/soak/verify-deployment-roles.ts",
    "deploy:keyed-suite": "tsx scripts/deploy-keyed-suite.ts",
    "deploy:mainnet-suite": "tsx scripts/deploy-mainnet-suite.ts",
    "register:erc8004": "tsx scripts/register-erc8004-agent.ts",
    "demo:record": "pnpm --dir scripts/demo-video record",
    "consumer:smoke:live": "tsx scripts/consumer-smoke-live.ts",
    "consumer:migrate:verify": "tsx scripts/consumer-migrate-verify.ts",
    "consumer:demo": "tsx scripts/consumer-demo.ts",
    "consumer:smoke": "tsx scripts/consumer-smoke.ts",
    "test:consumer-core": "node --import tsx --test packages/consumer-core/test/*.test.ts",
    "test:consumer-providers": "node --import tsx --test packages/consumer-providers/test/*.test.ts",
    "migrate:consumer": "pnpm --filter @untch/consumer-core migrate",
    "test:gov-watch": "node --import tsx --test packages/gov-watch/test/*.test.ts",
    "gov-watch": "pnpm --filter @untch/gov-watch watch",
    "prove:gov-watch": "pnpm --filter @untch/gov-watch prove:testnet",
    "lint:public-copy": "tsx scripts/lint-public-copy.ts",
    "test:lint-copy": "node --import tsx --test scripts/test/*.test.ts",
    "gen:solana-treasury": "tsx scripts/gen-solana-treasury.ts",
    "purch:funding": "tsx scripts/purch-funding-estimate.ts"
  },
  "dependencies": {
    "canonicalize": "^3.0.0",
    "viem": "^2.55.0"
  },
  "devDependencies": {
    "@babel/parser": "7.24.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "ioredis": "5.10.1",
      "postcss": "^8.5.16"
    }
  }
}
